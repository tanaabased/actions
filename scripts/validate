#!/usr/bin/env ruby
# frozen_string_literal: true

require "yaml"

root = File.expand_path("..", __dir__)
manifests = Dir.glob(File.join(root, ".github/workflows/*.{yml,yaml}")) +
  Dir.glob(File.join(root, "actions/*/action.{yml,yaml}")) +
  Dir.glob(File.join(root, "examples/*.{yml,yaml}"))

manifests.each do |path|
  YAML.load_file(path)
  relative_path = path.delete_prefix("#{root}/")
  puts "parsed #{relative_path}"
end

readme = File.read(File.join(root, "README.md"))
docs = readme.scan(/\]\((docs\/[^)#]+\.md)\)/).flatten
abort "README does not link to catalog documentation" if docs.empty?

docs.each do |path|
  abort "missing catalog documentation: #{path}" unless File.file?(File.join(root, path))
  puts "found #{path}"
end
