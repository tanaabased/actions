#!/usr/bin/env ruby
# frozen_string_literal: true

require "yaml"

root = File.expand_path("..", __dir__)
manifests = Dir.glob(File.join(root, ".github/workflows/*.{yml,yaml}")) +
  Dir.glob(File.join(root, "actions/*/action.{yml,yaml}")) +
  Dir.glob(File.join(root, "examples/*.{yml,yaml}"))

manifests.each do |path|
  YAML.load_file(path)
  relative_path = path.delete_prefix("#{root}/")
  puts "parsed #{relative_path}"
end

readme = File.read(File.join(root, "README.md"))
entries = readme.scan(/\]\((actions\/[^)#]+\/README\.md)\)/).flatten
abort "README does not link to catalog entries" if entries.empty?

entries.each do |path|
  entry = File.join(root, path)
  abort "missing catalog entry: #{path}" unless File.file?(entry)

  directory = File.dirname(entry)
  action = Dir.glob(File.join(directory, "action.{yml,yaml}")).first
  workflow = File.join(directory, "workflow.yml")

  if action
    puts "found composite action #{path}"
  elsif File.symlink?(workflow)
    target = File.realpath(workflow)
    expected = File.join(root, ".github/workflows/")
    abort "workflow link escapes .github/workflows: #{path}" unless target.start_with?(expected) && File.file?(target)
    puts "found reusable workflow #{path}"
  else
    abort "catalog entry has neither action manifest nor workflow link: #{path}"
  end
end

prepare = YAML.load_file(File.join(root, "actions/prepare-release/action.yml"))
prepare_step = prepare.fetch("runs").fetch("steps").find do |step|
  step["uses"] == "tanaabased/prepare-release-action@v1"
end
abort "prepare-release does not wrap prepare-release-action@v1" unless prepare_step
abort "prepare-release does not disable synchronization" unless prepare_step.fetch("with").fetch("sync") == false

publish = YAML.load_file(File.join(root, "actions/publish-repo/action.yml"))
publish_step = publish.fetch("runs").fetch("steps").find do |step|
  step["uses"] == "tanaabased/prepare-release-action@v1"
end
abort "publish-repo does not wrap prepare-release-action@v1" unless publish_step
publish_inputs = publish_step.fetch("with")
abort "publish-repo does not enable verified synchronization" unless publish_inputs.fetch("sync") == true && publish_inputs.fetch("sync-verified") == true
abort "publish-repo does not use tanaabot" unless publish_inputs.fetch("sync-username") == "tanaabot" && publish_inputs.fetch("sync-email") == "tanaabot@tanaab.dev"
abort "publish-repo does not forward moving tags" unless publish_inputs.fetch("sync-tags") == "${{ inputs.sync-tags }}"

release = YAML.load_file(File.join(root, ".github/workflows/release.yml"))
steps = release.fetch("jobs").fetch("publish-repo").fetch("steps")
publisher = steps.find { |step| step["uses"] == "./actions/publish-repo" }
abort "release workflow does not use the local publish-repo action" unless publisher
abort "release workflow does not synchronize v1" unless publisher.fetch("with").fetch("sync-tags") == "v1"

puts "release workflow synchronizes v1"
