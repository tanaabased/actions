#!/usr/bin/env bash
set -euo pipefail
case "$(basename "$0")" in
  dpkg-query)
    if [[ " ${TEST_INSTALLED:-} " == *" ${*: -1} "* ]]; then
      printf 'install ok installed'
    else
      printf 'deinstall ok config-files'
      exit 1
    fi
    ;;
  sudo)
    printf '%s\n' "$*" >> "$TEST_CALLS"
    [[ "$1" == -n && "$2" == timeout && "$3" == --kill-after=*s && "$5" == apt-get ]] || exit 91
    [[ "${4%s}" -le 300 ]] || exit 92
    if [[ " $* " == *' update '* ]]; then
      printf 'token=package-sentinel\n'
      exit "${TEST_UPDATE_STATUS:-0}"
    fi
    printf 'token=package-sentinel\n'
    exit "${TEST_INSTALL_STATUS:-0}"
    ;;
  timeout)
    [[ "$1" == 5 ]] || exit 93
    shift
    exec "$@"
    ;;
  getent)
    printf 'resolver fixture token=resolver-sentinel\n'
    exit "${TEST_RESOLVER_STATUS:-0}"
    ;;
esac
