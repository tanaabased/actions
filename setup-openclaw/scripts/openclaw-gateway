#!/usr/bin/env bash

set -euo pipefail

command_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=setup-openclaw/scripts/lib/openclaw-common.sh
source "$command_dir/lib/openclaw-common.sh"

action=''
profile=''
workspace=''
state_dir=''
timeout_seconds=''
debug_setting="${SETUP_OPENCLAW_DEBUG:-auto}"

usage() {
  cat <<'EOF'
Usage: openclaw-gateway <start|wait|restart|stop|diagnostics> --profile <name> --workspace <path> --state-dir <path> [options]

Commands:
  start                             starts the isolated gateway and waits for readiness
  wait                              waits for an already-started gateway
  restart                           stops and starts the isolated gateway
  stop                              stops the isolated gateway
  diagnostics                       prints bounded, redacted gateway diagnostics

Options:
  --profile <name>                  selects the isolated OpenClaw profile
  --workspace <path>                verifies the isolated agent workspace
  --state-dir <path>                locates isolated OpenClaw and process state
  --timeout <seconds>               bounds readiness or shutdown [default: 90; stop: 30]
  --debug <auto|true|false>         controls helper and OpenClaw verbosity [default: action setting or auto]
  -h, --help                        displays this help message
EOF
}

while (($# > 0)); do
  case "$1" in
    --profile | --workspace | --state-dir | --timeout | --debug)
      (($# >= 2)) || error "$1 requires a value" 2
      case "$1" in
        --profile) profile="$2" ;;
        --workspace) workspace="$2" ;;
        --state-dir) state_dir="$2" ;;
        --timeout) timeout_seconds="$2" ;;
        --debug) debug_setting="$2" ;;
      esac
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      usage >&2
      error "unrecognized option: $1" 2
      ;;
    *)
      if [[ -n "$action" ]]; then
        usage >&2
        error "unexpected argument: $1" 2
      fi
      action="$1"
      shift
      ;;
  esac
done

case "$action" in
  start | wait | restart | stop | diagnostics) ;;
  '')
    usage >&2
    error 'a command is required: start, wait, restart, stop, or diagnostics' 2
    ;;
  *)
    usage >&2
    error "unsupported command: $action" 2
    ;;
esac

require_github_actions
configure_debug "$debug_setting"
configure_context "$profile" "$workspace" "$state_dir"
verify_context

pid_path="$gateway_state_dir/gateway.pid"
log_path="$gateway_state_dir/gateway.log"
call_log_path="$gateway_state_dir/gateway-call.log"
if ! gateway_port="$(run_openclaw config get gateway.port 2>/dev/null)"; then
  error 'OpenClaw gateway port is unavailable'
fi
if [[ ! "$gateway_port" =~ ^[1-9][0-9]*$ ]] || ((gateway_port > 65535)); then
  error "OpenClaw gateway port is invalid: $gateway_port"
fi
gateway_health_url="http://127.0.0.1:$gateway_port/health"

wait_for_gateway() {
  local wait_timeout="$1"
  local deadline=$((SECONDS + wait_timeout))

  if ! read_gateway_pid; then
    error_message "gateway PID file is missing or invalid: $pid_path"
    return 1
  fi
  if ! gateway_is_running; then
    error_message "gateway PID is not an owned running process: $gateway_pid"
    return 1
  fi
  debug "waiting for gateway pid=$gateway_pid timeout=$wait_timeout"
  until node "$command_dir/lib/probe-health.mjs" "$gateway_health_url" > /dev/null 2> "$call_log_path"; do
    if ! gateway_is_running; then
      error_message 'gateway exited before becoming ready'
      return 1
    fi
    if ((SECONDS >= deadline)); then
      error_message "gateway did not become ready within $wait_timeout seconds"
      return 1
    fi
    sleep 1
  done
}

stop_gateway() {
  local stop_timeout="$1"
  local deadline

  if [[ ! -f "$pid_path" ]]; then
    return 0
  fi
  if ! read_gateway_pid; then
    error_message "gateway PID file is invalid: $pid_path"
    return 1
  fi
  if ! kill -0 "$gateway_pid" 2>/dev/null; then
    rm -f "$pid_path"
    return 0
  fi
  if ! gateway_is_running; then
    error_message "refusing to stop an unowned process from gateway PID file: $gateway_pid"
    return 1
  fi

  deadline=$((SECONDS + stop_timeout))
  debug "stopping gateway pid=$gateway_pid timeout=$stop_timeout"
  if ! kill -TERM "$gateway_pid" 2>/dev/null; then
    error_message "gateway could not be asked to stop: $gateway_pid"
    return 1
  fi
  while gateway_is_running; do
    if ((SECONDS >= deadline)); then
      error_message "gateway did not stop within $stop_timeout seconds; forcing termination"
      kill -KILL "$gateway_pid" 2>/dev/null || true
      sleep 1
      if gateway_is_running; then
        return 1
      fi
      rm -f "$pid_path"
      return 1
    fi
    sleep 1
  done
  rm -f "$pid_path"
}

start_gateway() {
  local start_timeout="$1"
  local failure_status

  if [[ -f "$pid_path" ]]; then
    if ! read_gateway_pid; then
      error_message "gateway PID file is invalid: $pid_path"
      return 1
    fi
    if gateway_is_running; then
      error_message "gateway is already running: $gateway_pid"
      return 1
    fi
    if kill -0 "$gateway_pid" 2>/dev/null; then
      error_message "refusing to replace a gateway PID file for an unowned process: $gateway_pid"
      return 1
    fi
    rm -f "$pid_path"
  fi

  : > "$log_path"
  debug "starting gateway log=$log_path"
  (
    exec env \
      OPENCLAW_CONFIG_PATH="$openclaw_config_path" \
      OPENCLAW_LOG_LEVEL="$OPENCLAW_LOG_LEVEL" \
      OPENCLAW_STATE_DIR="$openclaw_state_dir" \
      openclaw --profile "$profile" gateway run \
        --bind loopback \
        --auth none \
        --port "$gateway_port" >> "$log_path" 2>&1 < /dev/null
  ) &
  gateway_pid="$!"
  if ! gateway_started="$(gateway_process_start "$gateway_pid")" || [[ -z "$gateway_started" ]]; then
    error_message 'could not record gateway process identity'
    # This is the child just launched above, never a PID read from disk.
    kill -TERM "$gateway_pid" 2>/dev/null || true
    return 1
  fi
  printf '%s\n%s\n' "$gateway_pid" "$gateway_started" > "$pid_path"

  if wait_for_gateway "$start_timeout"; then
    return 0
  else
    failure_status=$?
  fi
  print_gateway_diagnostics
  stop_gateway 10 || true
  return "$failure_status"
}

case "$action" in
  start)
    timeout_seconds="${timeout_seconds:-90}"
    require_positive_integer timeout "$timeout_seconds"
    start_gateway "$timeout_seconds"
    ;;
  wait)
    timeout_seconds="${timeout_seconds:-90}"
    require_positive_integer timeout "$timeout_seconds"
    if wait_for_gateway "$timeout_seconds"; then
      :
    else
      gateway_status=$?
      print_gateway_diagnostics
      exit "$gateway_status"
    fi
    ;;
  restart)
    timeout_seconds="${timeout_seconds:-90}"
    require_positive_integer timeout "$timeout_seconds"
    stop_gateway "$timeout_seconds"
    start_gateway "$timeout_seconds"
    ;;
  stop)
    timeout_seconds="${timeout_seconds:-30}"
    require_positive_integer timeout "$timeout_seconds"
    if stop_gateway "$timeout_seconds"; then
      :
    else
      gateway_status=$?
      print_gateway_diagnostics
      exit "$gateway_status"
    fi
    ;;
  diagnostics)
    print_gateway_diagnostics
    ;;
esac
