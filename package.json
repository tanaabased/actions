{
  "name": "@tanaab/actions",
  "version": "1.0.9",
  "description": "Tanaab-based GitHub Actions catalog.",
  "author": "Mike Pirog and EMORI",
  "contributors": [
    {
      "name": "Mike Pirog",
      "url": "https://github.com/pirog"
    },
    {
      "name": "EMORI",
      "url": "https://github.com/emoriwan"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/tanaabased/actions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanaabased/actions.git"
  },
  "bugs": {
    "url": "https://github.com/tanaabased/actions/issues"
  },
  "keywords": [
    "tanaab",
    "github-actions",
    "composite-actions",
    "ci",
    "release"
  ],
  "packageManager": "bun@1.4.2",
  "scripts": {
    "lint:eslint": "bun run --bun eslint .",
    "format:check": "bun run --bun prettier . --check --ignore-unknown",
    "format:write": "bun run --bun prettier . --write --ignore-unknown",
    "lint": "bun run lint:eslint && bun run format:check",
    "test:unit": "node --test .lib/test/*.spec.mjs",
    "test:component": "node --test .lib/test/*.component.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "eslint-config-prettier": "^10.1.8"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    ".lib/pack-result.cjs",
    ".lib/resolve-debug.sh",
    ".lib/resolve-runtime.mjs",
    ".lib/resolve-package.mjs",
    "[!.]*/action.yml",
    "[!.]*/README.md",
    "[!.]*/icon.svg",
    "[!.]*/scripts/**",
    "[!.]*/examples/**",
    "[!.]*/LICENSE*",
    "[!.]*/NOTICE*",
    "!**/__pycache__/**",
    "!**/*.py[co]"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module"
}
