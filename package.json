{
  "name": "@tanaab/actions",
  "version": "1.0.8",
  "description": "Tanaab-based GitHub Actions catalog.",
  "author": "Mike Pirog and EMORI",
  "contributors": [
    {
      "name": "Mike Pirog",
      "url": "https://github.com/pirog"
    },
    {
      "name": "EMORI",
      "url": "https://github.com/emoriwan"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/tanaabased/actions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanaabased/actions.git"
  },
  "bugs": {
    "url": "https://github.com/tanaabased/actions/issues"
  },
  "keywords": [
    "tanaab",
    "github-actions",
    "composite-actions",
    "ci",
    "release"
  ],
  "packageManager": "bun@1.4.2",
  "scripts": {
    "lint": "bun --bun eslint .lib/resolve-package.mjs '.lib/test/resolve-package.*.mjs' setup-openclaw/scripts/lib/resolve-openclaw.mjs eslint.config.js",
    "test:unit": "node --test .lib/test/*.spec.mjs",
    "test:component": "node --test .lib/test/*.component.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    ".lib/resolve-debug.sh",
    ".lib/resolve-runtime.mjs",
    ".lib/resolve-package.mjs",
    "[!.]*/action.yml",
    "[!.]*/README.md",
    "[!.]*/icon.svg",
    "[!.]*/scripts/**",
    "[!.]*/examples/**",
    "[!.]*/LICENSE*",
    "[!.]*/NOTICE*"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
